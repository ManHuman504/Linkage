{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Linkage",
  "version": "0.1.0",
  "identifier": "com.linkage.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Linkage",
        "width": 800,
        "height": 480,
        "resizable": false,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/ManHuman504/Linkage/main/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEOEU4RDI2RTA5MkJFN0EKUldSNnZwTGdKbzJPblNHMW4vNytJQXJxTTEyb3ZPRWtZQ1YvajJLcG1pWFBVamdrMFo5dWczK2cK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../dist"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
